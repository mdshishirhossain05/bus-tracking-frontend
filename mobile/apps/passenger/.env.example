# Mobile app configuration (Expo inlines EXPO_PUBLIC_* at build time).
# Copy to `.env` and fill in. Point these at the SAME backend the web uses.

# Must include the API version prefix, e.g. /api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Google Maps SDK key (used on BOTH iOS and Android for a consistent dark map)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Initial map camera (defaults to Dhaka)
EXPO_PUBLIC_MAP_DEFAULT_LAT=23.8103
EXPO_PUBLIC_MAP_DEFAULT_LNG=90.4125
EXPO_PUBLIC_MAP_DEFAULT_ZOOM=14
