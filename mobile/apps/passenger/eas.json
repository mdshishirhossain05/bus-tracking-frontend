{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE-WITH-YOUR-BACKEND/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://REPLACE-WITH-YOUR-BACKEND",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "REPLACE-WITH-YOUR-GOOGLE-MAPS-KEY"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
